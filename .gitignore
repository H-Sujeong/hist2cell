# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/

# --- Notebooks ---
.ipynb_checkpoints/

# --- Large data archives ---
*.tar.gz
*.tar
*.zip
*.7z

# --- Hist2Cell datasets (untracked tar / unpacked) ---
Hist2Cell_data/
example_data/
example_data/*.tar.gz

# --- Preprocessing scratch dirs ---
prep_out/

# inference/ kept tracked except for the multi-GB .pt files (covered below).

# --- Saved patches and intermediate large files ---
**/patches/
**/2x_patches/
*.h5ad
*.h5
*.npz
# .npy is fine in inference/ (predictions are <15 MB); block elsewhere only if needed.

# Allow the small per-slide coordinate sidecar files (~30 KB each) — they
# carry the prep metadata needed to re-run inference without rebuilding
# patches.
!inference/**/*_coords.h5

# --- PyTorch Geometric processed data ---
# Ignores all *.pt PyG Data files. Note: *.pt does NOT match *.pth, so the
# already-tracked model_weights/*.pth files (~57MB each) remain tracked.
**/*.pt

# --- Image outputs (debug / overlays) ---
*.tmp.png
output*.png

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# --- Local agent / tool state ---
.claude/

# --- Logs ---
*.log
logs/

# --- Large WSI files (in case any get copied here) ---
*.svs
*.ndpi
*.tiff
*.tif
*.mrxs

# --- Allow project tracked notebooks even though .ipynb pattern is broad ---
# (no negation needed — we only ignore checkpoints, not .ipynb)
